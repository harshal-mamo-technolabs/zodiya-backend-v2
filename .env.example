PORT=
NODE_ENV=
MONGO_URI=
REFRESH_TOKEN_SECRET=
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GOOGLE_MAPS_API_KEY=
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
CORS_ORIGINS=
# false = the whole app is free: no plans, profile packs or minute limits, nothing for sale
PAYMENTS_ENABLED=true
HELPSCOUT_SECURE_MODE_KEY=
HELPSCOUT_MAILBOX_APP_ID=
HELPSCOUT_MAILBOX_APP_SECRET=
# palm reading; without it the app still runs and POST /palm/read answers 503 ai_not_configured
OPENAI_API_KEY=
# vision + structured-output model for the palm report
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_TIMEOUT_MS=60000
# image-edit model that redraws the palm photo with its lines highlighted (low | medium | high)
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_MS=120000
# palm photo storage (S3). The bucket must NOT be public-read: palm photos are
# served only through presigned URLs. Without these, palm requests answer 503 storage_not_configured
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=

# Klaviyo private key (scope: profiles and events, write). Funnel profiles and the
# ASTROMERIDIAN:* events sync only when it is set
KLAVIYO_PRIVATE_API_KEY=
