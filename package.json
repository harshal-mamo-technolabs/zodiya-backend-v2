{
    "name": "zodiya-backend-v2",
    "version": "1.0.0",
    "description": "",
    "license": "ISC",
    "author": "harshal",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "cross-env NODE_ENV=production node dist/server.js",
        "dev": "cross-env NODE_ENV=development nodemon --ext ts --exec \"node --import @swc-node/register/esm-register\" src/server.ts",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest --no-cache --coverage --all --runInBand",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint:check": "eslint .",
        "lint:fix": "eslint --fix .",
        "typecheck": "tsc --noEmit",
        "keys:generate": "node scripts/generateKeys.js",
        "db:migrate-from-mongo": "node --import @swc-node/register/esm-register scripts/migrate-mongo-to-mysql.ts",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "dependencies": {
        "astronomia": "^4.2.0",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.3",
        "express": "^5.2.1",
        "express-jwt": "^8.5.1",
        "express-rate-limit": "^8.7.0",
        "express-validator": "^7.3.2",
        "http-errors": "^2.0.1",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.24.4",
        "tz-lookup": "^6.1.25",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.5.1",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.2",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.20.2",
        "@types/supertest": "^7.2.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jest": "^30.5.1",
        "lint-staged": "^17.5.1",
        "mongodb": "^7.6.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0"
    },
    "allowScripts": {
        "bcrypt@6.0.0": true,
        "@swc/core@1.16.2": true,
        "unrs-resolver@1.12.2": true,
        "@parcel/watcher@2.6.0": true
    }
}
